{
  "event": "pre-tool",
  "matcher": {
    "tools": [
      "command"
    ]
  },
  "handler": {
    "mode": "exec",
    "program": "node",
    "arguments": [
      {
        "packageFile": "decision.mjs"
      },
      {
        "literal": "deny"
      }
    ]
  },
  "timeoutMilliseconds": 1000,
  "asynchronous": false,
  "failurePolicy": "closed",
  "order": 10
}
