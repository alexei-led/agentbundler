{
  "version": 1,
  "hooks": [
    {
      "identity": "hook/session",
      "location": { "path": "src/hooks/session/hook.json", "line": null, "column": null },
      "event": "session-start",
      "handler": {
        "mode": "exec",
        "program": "node",
        "arguments": [{ "literal": "-e" }, { "literal": "process.stdin.resume()" }]
      },
      "timeoutMilliseconds": 10000,
      "asynchronous": false,
      "failurePolicy": "open",
      "order": 10
    },
    {
      "identity": "hook/pre-tool",
      "location": { "path": "src/hooks/pre-tool/hook.json", "line": null, "column": null },
      "event": "pre-tool",
      "matcher": { "tools": ["command"] },
      "handler": {
        "mode": "exec",
        "program": "node",
        "arguments": [{ "literal": "-e" }, { "packageFile": "hooks/pre-tool.js" }]
      },
      "timeoutMilliseconds": 5000,
      "asynchronous": false,
      "failurePolicy": "closed",
      "order": 20
    }
  ]
}
