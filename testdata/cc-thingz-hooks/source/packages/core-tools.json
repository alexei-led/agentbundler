{
  "id": "core-tools",
  "metadata": {
    "version": "1.0.0",
    "description": "Shared command guard and review assets",
    "displayName": "Core tools",
    "author": {
      "name": "Agent Bundler"
    },
    "homepage": "https://github.com/alexei-led/agentbundler",
    "repository": "https://github.com/alexei-led/agentbundler",
    "license": "MIT",
    "keywords": [
      "guard",
      "hooks"
    ]
  },
  "assets": [
    "src/skills/review",
    {
      "path": "src/agents/reviewer.md",
      "targets": [
        "antigravity",
        "claude",
        "pi",
        "copilot",
        "cursor",
        "grok"
      ]
    },
    {
      "path": "src/hooks/command-guard",
      "targets": [
        "claude",
        "codex",
        "pi",
        "copilot",
        "cursor",
        "grok"
      ]
    },
    {
      "path": "src/plugins/antigravity/conductor-ux",
      "targets": [
        "antigravity"
      ]
    }
  ]
}
